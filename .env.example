# CiviSense Environment Configuration Template

# Frontend Target Backend URL (Vite)
VITE_API_URL=https://your-backend-url.vercel.app

# Application
APP_NAME=CIVISENSE
APP_VERSION=2.0.0
TAGLINE="Predict. Prioritize. Prevent."

# Pilot Geography
PILOT_REGION="Chandigarh & Punjab Tri-City Region"
PILOT_LAT=30.7333
PILOT_LON=76.7794
TIMEZONE="Asia/Kolkata"

# Database Configuration
# SQLite local development default:
DATABASE_URL="sqlite:///./civisense.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/civisense_db"

# External API Providers
OPEN_METEO_FORECAST_URL="https://api.open-meteo.com/v1/forecast"
OPEN_METEO_HISTORICAL_URL="https://archive-api.open-meteo.com/v1/archive"
OPEN_METEO_ELEVATION_URL="https://api.open-meteo.com/v1/elevation"
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"

# Server Ports
BACKEND_PORT=8001
FRONTEND_PORT=5173

